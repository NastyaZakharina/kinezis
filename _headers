# Cloudflare Pages / static hosting cache headers

/images/*
  Cache-Control: public, max-age=31536000, immutable

/images/towari/*
  Cache-Control: public, max-age=31536000, immutable

/images/products/*
  Cache-Control: public, max-age=31536000, immutable

/images/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=86400

/style.css
  Cache-Control: public, max-age=86400

/main.js
  Cache-Control: public, max-age=86400

/data.js
  Cache-Control: public, max-age=86400

/cart.js
  Cache-Control: public, max-age=86400

/logo.png
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=3600
